      "parameters": {
        "jsCode": "const row = $json;\n\n// payload puede estar guardado como string JSON o como objeto jsonb\nlet stored;\ntry {\n  stored = (typeof row.payload === 'string') ? JSON.parse(row.payload) : row.payload;\n} catch (e) {\n  stored = { parse_error: String(e), raw_payload: row.payload };\n}\n\nreturn [{\n  json: {\n    // Identidad del evento\n    execution_id: row.execution_id,\n    workflow_name: row.workflow_name,\n    prev_error: row.error_message,\n    retry_count: row.retry_count ?? 0,\n\n    // payload parseado\n    stored_payload: stored,\n    execution_url: stored?.execution?.url,\n\n    // Datos de Slack pasados por el caller (Workflow 2)\n    channel: $node['Webhook: Replay Worker'].json.channel,\n    message_ts: $node['Webhook: Replay Worker'].json.message_ts,\n    requested_by: $node['Webhook: Replay Worker'].json.requested_by\n  }\n}];"
      },
